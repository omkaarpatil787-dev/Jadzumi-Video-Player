<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Allows playback controls on lock screen and notification shade on Android 13-16 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".JadzumiApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_aura"
        android:label="Jadzumi Video"
        android:roundIcon="@drawable/ic_launcher_aura"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".LauncherAura"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_aura"
            android:roundIcon="@drawable/ic_launcher_aura"
            android:label="Jadzumi Video"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherFrost"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_frost"
            android:roundIcon="@drawable/ic_launcher_frost"
            android:label="Jadzumi Video"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNeo"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_neo"
            android:roundIcon="@drawable/ic_launcher_neo"
            android:label="Jadzumi Video"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherSoft"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_soft"
            android:roundIcon="@drawable/ic_launcher_soft"
            android:label="Jadzumi Video"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPrism"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_prism"
            android:roundIcon="@drawable/ic_launcher_prism"
            android:label="Jadzumi Video"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
